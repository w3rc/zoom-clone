<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Video Conference - Room <%= roomID.substring(0, 8) %></title>
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
		<style>
			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}

			body {
				font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
				background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
				color: white;
				height: 100vh;
				overflow: hidden;
			}

			.container {
				display: flex;
				flex-direction: column;
				height: 100vh;
			}

			/* Header */
			.header {
				background: rgba(0, 0, 0, 0.8);
				padding: 15px 20px;
				display: flex;
				justify-content: space-between;
				align-items: center;
				backdrop-filter: blur(10px);
			}

			.meeting-info h1 {
				font-size: 1.2rem;
				margin-bottom: 5px;
			}

			.room-id {
				font-size: 0.9rem;
				opacity: 0.8;
			}

			.header-controls {
				display: flex;
				gap: 10px;
			}

			.btn {
				padding: 8px 16px;
				border: none;
				border-radius: 6px;
				cursor: pointer;
				font-size: 0.9rem;
				transition: all 0.3s ease;
				display: flex;
				align-items: center;
				gap: 5px;
			}

			.btn-copy {
				background: rgba(255, 255, 255, 0.2);
				color: white;
			}

			.btn-copy:hover {
				background: rgba(255, 255, 255, 0.3);
			}

			/* Main content area */
			.main-content {
				flex: 1;
				display: flex;
				position: relative;
			}

			/* Video area */
			.video-area {
				flex: 1;
				padding: 20px;
				display: flex;
				flex-direction: column;
			}

			.video-grid {
				flex: 1;
				display: grid;
				gap: 10px;
				grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
				grid-auto-rows: minmax(200px, 1fr);
				max-height: calc(100vh - 160px);
				overflow-y: auto;
			}

			.video-container {
				position: relative;
				background: #000;
				border-radius: 8px;
				overflow: hidden;
				box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
			}

			.video-container video {
				width: 100%;
				height: 100%;
				object-fit: cover;
			}

			.video-overlay {
				position: absolute;
				bottom: 10px;
				left: 10px;
				background: rgba(0, 0, 0, 0.7);
				padding: 5px 10px;
				border-radius: 4px;
				font-size: 0.8rem;
			}

			.connection-status {
				position: absolute;
				top: 10px;
				right: 10px;
				width: 8px;
				height: 8px;
				border-radius: 50%;
				background: #00ff00;
			}

			.connection-status.poor {
				background: #ff4444;
			}

			.connection-status.moderate {
				background: #ffaa00;
			}

			/* Control panel */
			.controls {
				background: rgba(0, 0, 0, 0.8);
				padding: 15px 20px;
				display: flex;
				justify-content: center;
				align-items: center;
				gap: 15px;
				backdrop-filter: blur(10px);
			}

			.control-btn {
				width: 50px;
				height: 50px;
				border-radius: 50%;
				border: none;
				cursor: pointer;
				font-size: 1.2rem;
				transition: all 0.3s ease;
				display: flex;
				align-items: center;
				justify-content: center;
			}

			.control-btn.mic {
				background: #4CAF50;
				color: white;
			}

			.control-btn.mic.muted {
				background: #f44336;
			}

			.control-btn.camera {
				background: #2196F3;
				color: white;
			}

			.control-btn.camera.disabled {
				background: #f44336;
			}

			.control-btn.screen {
				background: #FF9800;
				color: white;
			}

			.control-btn.screen.active {
				background: #4CAF50;
			}

			.control-btn.leave {
				background: #f44336;
				color: white;
			}

			.control-btn:hover {
				transform: scale(1.1);
			}

			/* Sidebar */
			.sidebar {
				width: 300px;
				background: rgba(0, 0, 0, 0.9);
				border-left: 1px solid rgba(255, 255, 255, 0.1);
				display: flex;
				flex-direction: column;
				transform: translateX(100%);
				transition: transform 0.3s ease;
			}

			.sidebar.open {
				transform: translateX(0);
			}

			.sidebar-header {
				padding: 20px;
				border-bottom: 1px solid rgba(255, 255, 255, 0.1);
			}

			.sidebar-content {
				flex: 1;
				padding: 20px;
				overflow-y: auto;
			}

			.participant {
				display: flex;
				align-items: center;
				gap: 10px;
				padding: 10px 0;
				border-bottom: 1px solid rgba(255, 255, 255, 0.1);
			}

			.participant-avatar {
				width: 32px;
				height: 32px;
				border-radius: 50%;
				background: #4CAF50;
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 0.8rem;
			}

			/* Join screen */
			.join-screen {
				position: fixed;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
				display: flex;
				align-items: center;
				justify-content: center;
				z-index: 1000;
			}

			.join-card {
				background: rgba(255, 255, 255, 0.1);
				padding: 40px;
				border-radius: 16px;
				backdrop-filter: blur(15px);
				border: 1px solid rgba(255, 255, 255, 0.2);
				text-align: center;
				max-width: 400px;
				width: 90%;
			}

			.join-card h2 {
				margin-bottom: 20px;
				font-size: 1.8rem;
			}

			.preview-video {
				width: 100%;
				height: 200px;
				background: #000;
				border-radius: 8px;
				margin: 20px 0;
			}

			.input-group {
				margin: 20px 0;
				text-align: left;
			}

			.input-group label {
				display: block;
				margin-bottom: 5px;
				font-size: 0.9rem;
			}

			.input-group input, .input-group select {
				width: 100%;
				padding: 12px;
				border: 1px solid rgba(255, 255, 255, 0.3);
				border-radius: 6px;
				background: rgba(255, 255, 255, 0.1);
				color: white;
				font-size: 1rem;
			}

			.input-group input::placeholder {
				color: rgba(255, 255, 255, 0.7);
			}

			.btn-join {
				background: #4CAF50;
				color: white;
				padding: 12px 30px;
				font-size: 1.1rem;
				border-radius: 6px;
				width: 100%;
				margin-top: 20px;
			}

			.btn-join:hover {
				background: #45a049;
			}

			.hidden {
				display: none !important;
			}

			/* Responsive design */
			@media (max-width: 768px) {
				.sidebar {
					width: 100%;
				}

				.video-grid {
					grid-template-columns: 1fr;
				}

				.controls {
					padding: 10px;
				}

				.control-btn {
					width: 45px;
					height: 45px;
					font-size: 1rem;
				}
			}
		</style>
	</head>
	<body>
		<!-- Join Screen -->
		<div id="joinScreen" class="join-screen">
			<div class="join-card">
				<h2>Join Video Conference</h2>
				<video id="previewVideo" class="preview-video" muted autoplay></video>
				<div class="input-group">
					<label for="userName">Your Name</label>
					<input type="text" id="userName" placeholder="Enter your name" />
				</div>
				<div class="input-group">
					<label for="cameraSelect">Camera</label>
					<select id="cameraSelect"></select>
				</div>
				<div class="input-group">
					<label for="micSelect">Microphone</label>
					<select id="micSelect"></select>
				</div>
				<button id="joinBtn" class="btn btn-join">Join Meeting</button>
			</div>
		</div>

		<!-- Main App -->
		<div id="mainApp" class="container hidden">
			<!-- Header -->
			<div class="header">
				<div class="meeting-info">
					<h1>Video Conference</h1>
					<div class="room-id">Room ID: <%= roomID.substring(0, 8) %>...</div>
				</div>
				<div class="header-controls">
					<button id="copyRoomBtn" class="btn btn-copy">
						<i class="fas fa-copy"></i> Copy Room Link
					</button>
					<button id="participantsBtn" class="btn btn-copy">
						<i class="fas fa-users"></i> Participants (<span id="participantCount">1</span>)
					</button>
				</div>
			</div>

			<!-- Main Content -->
			<div class="main-content">
				<!-- Video Area -->
				<div class="video-area">
					<div id="videoGrid" class="video-grid"></div>
				</div>

				<!-- Sidebar -->
				<div id="sidebar" class="sidebar">
					<div class="sidebar-header">
						<h3>Participants</h3>
					</div>
					<div class="sidebar-content">
						<div id="participantsList"></div>
					</div>
				</div>
			</div>

			<!-- Controls -->
			<div class="controls">
				<button id="micBtn" class="control-btn mic" title="Mute/Unmute (M)">
					<i class="fas fa-microphone"></i>
				</button>
				<button id="cameraBtn" class="control-btn camera" title="Camera On/Off (C)">
					<i class="fas fa-video"></i>
				</button>
				<button id="screenBtn" class="control-btn screen" title="Share Screen (S)">
					<i class="fas fa-desktop"></i>
				</button>
				<button id="leaveBtn" class="control-btn leave" title="Leave Meeting (L)">
					<i class="fas fa-phone-slash"></i>
				</button>
			</div>
		</div>

		<script>
			const ROOM_ID = '<%= roomID %>';
		</script>
		<script defer src="https://unpkg.com/peerjs@1.3.1/dist/peerjs.min.js"></script>
		<script defer src="/socket.io/socket.io.js"></script>
		<script defer src="client.js"></script>
	</body>
</html>
